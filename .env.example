# Vision-capable model for the VLA planner. Groq is the default (free
# tier, and currently the only provider here confirmed to have a working
# free vision model -- qwen/qwen3.6-27b). Get a key at console.groq.com.
GROQ_API_KEY=

# To use a different OpenAI-compatible provider instead (e.g. OpenRouter),
# set these three and they override the Groq default -- no code change:
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=

SPEECHMATICS_API_KEY=
